{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client", "bun"],
    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*"],
      "@open-erp/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
