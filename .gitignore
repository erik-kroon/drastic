# Agent work packs keep machine-checkable evidence: manifests, check results and
# captured source hashes stay tracked so a completed wave can be re-verified.
# Only bulky or per-attempt execution output is dropped, never the results.
.agents/work/**/*.exit
.agents/work/**/*.patch
.agents/work/**/*.pid
.agents/work/**/*.png
.agents/work/**/*.sha256
.agents/work/**/*.webm
.agents/work/**/*.zip
.agents/work/**/.last-run.json
.agents/work/**/error-context.md

# Local Cloudflare runtime and development secrets
.wrangler/
.dev.vars
.design-system/paper-route-matrix.json
