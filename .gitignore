# Build outputs
# These paths are load-bearing, not cosmetic: infra/alchemy deploys the web Worker
# from apps/web and apps/api/scripts/self-host.ts serves apps/web/dist/client.
# Move them only together with those two readers.
dist
build
/output/
test-results
*.tsbuildinfo
# Scoped type-check configs written and removed by `bun run check:changed`.
tsconfig.changed.json
.tsconfig.changed-*.json
apps/web/.tanstack/
apps/api/.wrangler/
apps/web/.wrangler/

# Generated files
apps/web/src/routeTree.gen.ts
graphify-out/
local.db
local.db-*

