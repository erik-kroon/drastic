addingInline: '24px' }}>\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexShrink: '0', width: '22px' }}>\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n                <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#1E6256\" />\n                <path d=\"M4.4 7.2l1.9 1.9 3.3-3.6\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n              </svg>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '2px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                Tryckhuset Norr AB, faktura 5521\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n                Godkänd av Elin Sund 2 okt 09:13\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-success-text)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px', width: '150px' }}>\n              Bokförd A153\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', display: 'flex', flexShrink: '0', flexWrap: 'wrap', fontFamily: 'var(--font-k26-ui)', fontFeatureSettings: '\"tnum\"', fontSize: '13px', justifyContent: 'end', lineHeight: '16px', textAlign: 'right', width: '100px' }}>\n              3 150,00\n            </div>\n          </div>\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '2', gap: '14px' }}>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '15px', fontWeight: 600, lineHeight: '20px' }}>\n            Arbetslista\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Rad 40 px, eller 52 px med en andra rad. Statusikon i 22 px kolumn. Tillstånd 150 px, belopp 100 px högerställt.\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Vald rad: selected-row och 3 px blå vänsterkant. Grupprubrik 12/600 med antal i pill.\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Tillståndstexten har samma färg som ikonen. Neutral text är secondary.\n          </div>\n          <div style={{ backgroundColor: 'var(--color-k26-side-surface)', borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', fontFamily: 'var(--font-k26-ui)', paddingBlock: '12px', paddingInline: '14px' }}>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n              Bredd: med detaljpanel går listan kant i kant med 32 px inre marginal (K-10, K-40, K-50, K-60). Utan panel ligger den i ett kort inom sidans marginal (K-20). På fokussidor följer kortet 1000 px-kolumnen (K-41).\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style={{ borderTopColor: 'var(--color-k26-rule)', borderTopStyle: 'solid', borderTopWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '48px', paddingTop: '32px' }}>\n        <div style={{ borderColor: 'var(--color-k26