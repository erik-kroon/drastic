svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n            <circle cx=\"8\" cy=\"8\" r=\"2.2\" fill=\"none\" stroke=\"#64748B\" strokeWidth=\"1.4\" strokeLinecap=\"round\" />\n            <path d=\"M8 2v2M8 12v2M2 8h2M12 8h2M3.8 3.8l1.4 1.4M10.8 10.8l1.4 1.4M3.8 12.2l1.4-1.4M10.8 5.2l1.4-1.4\" fill=\"none\" stroke=\"#64748B\" strokeWidth=\"1.4\" strokeLinecap=\"round\" />\n          </svg>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', flexBasis: '0%', flexGrow: '1', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n            Inställningar\n          </div>\n        </div>\n        <div style={{ alignItems: 'center', boxSizing: 'border-box', display: 'flex', flexShrink: '0', gap: '8px', height: 'var(--spacing-k26-field-height)', paddingInline: '8px' }}>\n          <div style={{ alignItems: 'center', backgroundColor: '#E3E8F2', borderRadius: '10px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '20px', justifyContent: 'center', width: '20px' }}>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', display: 'flex', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', fontWeight: 600, lineHeight: '16px' }}>\n              ES\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', flexBasis: '0%', flexGrow: '1', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n            Elin Sund\n          </div>\n        </div>\n      </div>\n      <div style={{ alignSelf: 'stretch', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexGrow: '1', minWidth: '0px' }}>\n        <div style={{ alignItems: 'center', backgroundColor: 'var(--color-k26-surface)', borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', gap: '8px', height: 'var(--spacing-k26-bar-height)', paddingInline: 'var(--spacing-k26-gutter)' }}>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', display: 'inline-block', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px', width: 'max-content' }}>\n            Försäljning\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', display: 'inline-block', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n            /\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', display: 'inline-block', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px', width: 'max-content' }}>\n            Fakturor\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', display: 'inline-block', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n            /\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', display: 'inline-block', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', fontWeight: 600, lineHeight: '16px', width: 'max-content' }}>\n            Påminnelse, F-2026-0038\n          </div>\n        </div>\n        <div style={{ backgroundColor: 'var(--color-k26-side-surface)', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexGrow: '1', minHeight: '0px' }}>\n          <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexGrow: '1', gap: '20px', minWidth: '0px', paddingBottom: '32px', paddingInline: '32px', paddingTop: '28px' }}>\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '6px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '20px', fontWeight: 600, letterSpacing: '-0.01em', lineHeight: '26px' }}>\n                Det här skickas\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '18px' }}>\n                Förberedd av Sara Lind 2 okt 08:40. Mottagare, text och bilaga granskas tillsammans.\n              </div>\n            </div>\n            <div style={{ backgroundColor: 'var(--color-k26-surface)', borderColor: 'var(--color-k26-rule)', borderRadius: '10px', borderStyle: 'solid', borderWidth: '1px', boxShadow: '#0F172A0A 0px 1px 2px, #0F172A0A 0px 4px 16px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', overflow: 'clip', width: '760px' }}>\n              <div style={{ borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', paddingBlock: '6px', paddingInline: '24px' }}>\n                <div style={{ alignItems: 'center', borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '36px' }}>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px', width: '64px' }}>\n                    Till\n                  </div>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n                    ekonomi@bjorkdalen.example.test\n                  </div>\n                </div>\n                <div style={{ alignItems: 'center', borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '36px' }}>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px', width: '64px' }}>\n                    Från\n                  </div>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px' }}>\n                    Fjällby Konsult AB, via Elin Sund\n                  </div>\n                </div>\n                <div style={{ alignItems: 'center', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '36px' }}>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', lineHeight: '16px', width: '64px' }}>\n                    Ämne\n                  </div>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', fontWeight: 600, lineHeight: '16px' }}>\n                    Påminnelse: faktura F-2026-0038, förföll 13 september\n                  </div>\n                </div>\n              </div>\n              <div style={{ boxSizing: 'border-box', display: 'flex', paddingBlock: '28px', paddingLeft: '88px', paddingRight: '24px' }}>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '22px', maxWidth: '560px', whiteSpace: 'pre-wrap' }}>\n                  Hej,<br /><br />faktura F-2026-0038 på 18 750,00 kr förföll den 13 september. Vi ser att den ännu inte är betald. Betala gärna snarast, uppgifterna finns på den bifogade fakturan.<br /><br />Hör av dig om fakturan redan är betald eller om något är oklart.<br /><br />Vänliga hälsningar<br />Fjällby Konsult AB\n                </div>\n              </div>\n              <div style={{ alignItems: 'center', backgroundColor: '#FBFCFD', borderTopColor: 'var(--color-k26-rule)', borderTopStyle: 'solid', borderTopWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '14px', paddingBlock: '14px', paddingLeft: '88px', paddingRight: '24px' }}>\n                <div style={{ alignItems: 'center', backgroundColor: 'var(--color-k26-surface)', borderColor: 'var(--color-k26-control)', borderRadius: '4px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '40px', justifyContent: 'center', width: '32px' }}>\n                  <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n                    <path d=\"M4 2h6l3 3v9H4zM10 2v3h3M6 8.5h4M6 11h4\" fill=\"none\" stroke=\"#64748B\" strokeWidth=\"1.3\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n                  </svg>\n                </div>\n                <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexGrow: '1', gap: '2px' }}>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-body)', fontWeight: 500, lineHeight: '16px' }}>\n                    F-2026-0038.pdf\n                  </div>\n                  <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--text-k26-caption)', lineHeight: '16px' }}>\n                    Fakturan, 1 sida, 84 kB\n                  </div>\n                </div>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', fontFamily: 'var(--font-k26-ui)', fontSize: 'var(--tex