6px', justifyContent: 'center', paddingInline: '16px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                Behåll\n              </div>\n            </div>\n            <div style={{ alignItems: 'center', backgroundColor: 'var(--color-k26-error-text)', borderRadius: '6px', boxSizing: 'border-box', display: 'flex', height: '36px', justifyContent: 'center', paddingInline: '16px' }}>\n              <div style={{ boxSizing: 'border-box', color: '#FFFFFF', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n                Avbryt påminnelsen\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style={{ alignItems: 'start', boxSizing: 'border-box', display: 'flex', gap: '32px' }}>\n        <div style={{ backgroundColor: 'var(--color-k26-surface)', borderRadius: '12px', boxShadow: '#0F172A14 0px 0px 0px 1px, #0F172A26 0px 12px 32px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', overflow: 'clip', width: '640px' }}>\n          <div style={{ alignItems: 'center', borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', gap: '10px', height: '52px', paddingInline: '18px' }}>\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"4.5\" fill=\"none\" stroke=\"var(--color-k26-caption)\" strokeWidth=\"1.5\" />\n              <path d=\"M10.5 10.5L14 14\" fill=\"#000000\" stroke=\"var(--color-k26-caption)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', flexBasis: '0%', flexGrow: '1', 