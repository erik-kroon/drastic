<div style={{ backgroundColor: 'var(--color-k26-rule)', boxSizing: 'border-box', flexShrink: '0', height: '1px', marginBottom: '6px', marginLeft: '4px', marginRight: '4px', marginTop: '6px' }} />\n            <div style={{ alignItems: 'center', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '32px', paddingInline: '10px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-error-text)', flexBasis: '0%', flexGrow: '1', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                Avvisa förslaget\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px', width: '300px' }}>\n            Kommandosök (Ctrl K) hittar uppgifter, motparter och dokument i det valda företaget. Menyer har kortkommandon och den riskabla raden sist, i rött.\n          </div>\n        </div>\n      </div>\n      <div style={{ alignItems: 'start', borderTopColor: 'var(--color-k26-rule)', borderTopStyle: 'solid', borderTopWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '32px', paddingTop: '32px' }}>\n        <div style={{ backgroundColor: '#CDD2DA', borderRadius: '12px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '440px', justifyContent: 'end', overflow: 'clip', width: '820px' }}>\n          <div style={{ backgroundColor: 'var(--color-k26-surface)', boxShadow: '#0F172A26 -12px 0px 32px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', height: '100%', width: '400px' }}>\n            <div style={{ alignItems: 'center', borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '52px', justifyContent: 'space-between', paddingInline: '24px' }}>\n              <div style={{ boxSizing: 'border-