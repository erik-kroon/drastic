lor-k26-control)', borderRadius: '6px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '32px', justifyContent: 'center', width: '140px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                Hovring\n              </div>\n            </div>\n            <div style={{ alignItems: 'center', borderColor: 'var(--color-k26-control)', borderRadius: '6px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', gap: '6px', height: '28px', justifyContent: 'center', width: '140px' }}>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n                <path d=\"M10.5 4.5l-5 5a1.8 1.8 0 002.5 2.5l5.5-5.5a3 3 0 00-4.2-4.2L3.8 7.8a4.2 4.2 0 006 6l4.2-4.2\" fill=\"none\" stroke=\"var(--color-k26-secondary)\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n              </svg>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                Bifoga fil\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '4px' }}>\n              <div style={{ alignItems: 'center', borderColor: 'var(--color-k26-control)', borderRadius: '6px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '28px', justifyContent: 'center', width: '28px' }}>\n                <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n                  ‹\n                </div>\n              </div>\n              <div style={{ align