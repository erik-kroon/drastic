{"content":[{"type":"text","text":"{\n  \"file\": {\n    \"id\": \"01M3M9A2DA2G08DSJA5K8ZE68S\",\n    \"name\": \"Enthusiastic lantern\"\n  },\n  \"contentHash\": {\n    \"tokens\": \"8e14c182\"\n  }\n}"},{"type":"text","text":"(\n    <div style={{ backgroundColor: '#FFFFFF', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', fontSize: '12px', fontSynthesis: 'none', gap: '48px', height: 'fit-content', lineHeight: '16px', MozOsxFontSmoothing: 'grayscale', overflow: 'clip', overflowWrap: 'anywhere', padding: '64px', WebkitFontSmoothing: 'antialiased', width: '1440px' }}>\n      <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '10px', maxWidth: '760px' }}>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', fontWeight: 600, letterSpacing: '0.06em', lineHeight: '16px' }}>\n          K-04 KOMPONENTER\n        </div>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '40px', fontWeight: 600, letterSpacing: '-0.03em', lineHeight: '46px' }}>\n          Status och återkoppling\n        </div>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '16px', lineHeight: '24px' }}>\n          Åtta statusar räcker för hela produkten. Samma ikon och färg i listan, i panelen och i notisen.\n        </div>\n      </div>\n      <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '20px' }}>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '20px', fontWeight: 600, letterSpacing: '-0.01em', lineHeight: '28px' }}>\n          Statusikoner\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', gap: '16px' }}>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#2448A5\" strokeWidth=\"1.4\" />\n              <path d=\"M7 3.5a3.5 3.5 0 010 7z\" fill=\"#2448A5\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Förslag\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Förberett, väntar på beslut\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.4\" />\n              <path d=\"M7 4v3.4M7 9.4v.2\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.4\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-warning-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Behöver dig\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Fråga, saknat underlag\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#2448A5\" strokeWidth=\"1.4\" />\n              <path d=\"M5 7h4M7.5 5.2L9.3 7 7.5 8.8\" fill=\"none\" stroke=\"#2448A5\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Svar kom\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Tillbaka hos dig\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#94A3B8\" strokeWidth=\"1.4\" strokeDasharray=\"2.4 2\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Ej läst\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Typ eller data saknas\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#64748B\" strokeWidth=\"1.4\" />\n              <path d=\"M7 4.2V7l1.8 1.2\" fill=\"none\" stroke=\"#64748B\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Bevakas\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Väntar på någon annan\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#B4232A\" strokeWidth=\"1.4\" />\n              <path d=\"M7 4.2V7l1.8 1.2\" fill=\"none\" stroke=\"#B4232A\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-error-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Förfallen\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Datum har passerat\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#FBF1DC\" stroke=\"#8A5A00\" />\n              <path d=\"M5.6 5.6a1.4 1.4 0 112 1.3c-.4.2-.6.5-.6.9M7 9.6v.1\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.3\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-warning-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Okänt utfall\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Skickat, svar saknas\n            </div>\n          </div>\n          <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '10px', padding: '16px' }}>\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#1E6256\" />\n              <path d=\"M4.4 7.2l1.9 1.9 3.3-3.6\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-success-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n              Klart\n            </div>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Bokfört, skickat, matchat\n            </div>\n          </div>\n        </div>\n      </div>\n      <div style={{ borderTopColor: 'var(--color-k26-rule)', borderTopStyle: 'solid', borderTopWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '48px', paddingTop: '32px' }}>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '12px' }}>\n          <div style={{ boxSizing: 'border-box', fontFamily: 'var(--font-k26-ui)', paddingBottom: '8px' }}>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '20px', fontWeight: 600, letterSpacing: '-0.01em', lineHeight: '28px' }}>\n              Besked i panelen\n            </div>\n          </div>\n          <div style={{ alignItems: 'center', boxSizing: 'border-box', display: 'flex', gap: '8px' }}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#1E6256\" />\n              <path d=\"M4.4 7.2l1.9 1.9 3.3-3.6\" fill=\"none\" stroke=\"#FFFFFF\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-success-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n              Beloppen stämmer med originalet\n            </div>\n          </div>\n          <div style={{ alignItems: 'center', boxSizing: 'border-box', display: 'flex', gap: '8px' }}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.4\" />\n              <path d=\"M7 4v3.4M7 9.4v.2\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.4\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-warning-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n              Momsen på rad 2 går inte att läsa\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', fontFamily: 'var(--font-k26-ui)', paddingBottom: '8px' }}>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n              Kontrollrad: ikon och en mening. Används för det som är bekräftat eller tveksamt.\n            </div>\n          </div>\n          <div style={{ backgroundColor: '#FBF6EA', borderColor: '#EFDDB4', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '10px', paddingBlock: '12px', paddingInline: '14px' }}>\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#FBF1DC\" stroke=\"#8A5A00\" />\n              <path d=\"M5.6 5.6a1.4 1.4 0 112 1.3c-.4.2-.6.5-.6.9M7 9.6v.1\" fill=\"none\" stroke=\"#8A5A00\" strokeWidth=\"1.3\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '2px' }}>\n              <div style={{ boxSizing: 'border-box', color: '#5C3D00', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n                Okänt utfall\n              </div>\n              <div style={{ boxSizing: 'border-box', color: '#5C3D00', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '18px' }}>\n                Kontrollera om verifikationen skapades innan du godkänner igen.\n              </div>\n            </div>\n          </div>\n          <div style={{ backgroundColor: '#FCF1F1', borderColor: '#F0CACC', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', gap: '10px', paddingBlock: '12px', paddingInline: '14px' }}>\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"5.5\" fill=\"none\" stroke=\"#B4232A\" strokeWidth=\"1.4\" />\n              <path d=\"M7 4v3.4M7 9.4v.2\" fill=\"none\" stroke=\"#B4232A\" strokeWidth=\"1.4\" strokeLinecap=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '2px' }}>\n              <div style={{ boxSizing: 'border-box', color: '#7A161B', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '16px' }}>\n                Godkännandet gäller inte längre\n              </div>\n              <div style={{ boxSizing: 'border-box', color: '#7A161B', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '18px' }}>\n                Beloppet ändrades 2 okt 09:20. Granska den nya versionen.\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-caption)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', lineHeight: '16px' }}>\n            Ruta: bara när något blockerar beslutet. Rubrik säger tillståndet, raden under säger vad du gör.\n          </div>\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '12px' }}>\n          <div style={{ boxSizing: 'border-box', fontFamily: 'var(--font-k26-ui)', paddingBottom: '8px' }}>\n            <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '20px', fontWeight: 600, letterSpacing: '-0.01em', lineHeight: '28px' }}>\n              Notiser\n            </div>\n          </div>\n          <div style={{ alignItems: 'center', backgroundColor: 'var(--color-k26-text)', borderRadius: '10px', boxShadow: '#0F172A33 0px 8px 24px', boxSizing: 'border-box', display: 'flex', gap: '12px', paddingBlock: '12px', paddingInline: '14px', width: '400px' }}>\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 14 14\" xmlns=\"http://www.w3.org/2000/svg\" style={{ display: 'inline-block', flexShrink: '0' }}>\n              <circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#4FB39C\" />\n              <path d=\"M4.4 7.2l1.9 1.9 3.3-3.6\" fill=\"none\" stroke=\"#0F172A\" strokeWidth=\"1.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            </svg>\n            <div style={{ boxSizing: 'border-box', color: '#FFFFFF', flexBasis: '0%', flexGrow: '1', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '16px' }}>\n              Bokförd som A153\n            </div>\n            <div style={{ boxSizing: 'border-box', color: '#9DB7F5', fontFami