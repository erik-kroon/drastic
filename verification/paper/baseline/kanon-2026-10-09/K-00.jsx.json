{"content":[{"type":"text","text":"{\n  \"file\": {\n    \"id\": \"01M3M9A2DA2G08DSJA5K8ZE68S\",\n    \"name\": \"Enthusiastic lantern\"\n  },\n  \"contentHash\": {\n    \"tokens\": \"8e14c182\"\n  }\n}"},{"type":"text","text":"(\n    <div style={{ backgroundColor: '#FFFFFF', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', fontSynthesis: 'none', gap: '48px', height: 'fit-content', MozOsxFontSmoothing: 'grayscale', overflow: 'clip', overflowWrap: 'anywhere', padding: '64px', WebkitFontSmoothing: 'antialiased', width: '1440px' }}>\n      <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '10px', maxWidth: '760px' }}>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', fontFamily: 'var(--font-k26-ui)', fontSize: '12px', fontWeight: 600, letterSpacing: '0.06em', lineHeight: '16px' }}>\n          K-00 KANON\n        </div>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '40px', fontWeight: 600, letterSpacing: '-0.03em', lineHeight: '46px' }}>\n          Så bygger du en skärm\n        </div>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '16px', lineHeight: '24px' }}>\n          Den här sidan är källan. Varje skärm i Drastic använder en av tre layouter, samma detaljpanel och samma komponenter. Saknas en skärm här, bygg den av delarna nedan i stället för att hitta på något nytt.\n        </div>\n      </div>\n      <div style={{ boxSizing: 'border-box', display: 'flex', gap: '32px' }}>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '12px' }}>\n          <div style={{ borderColor: 'var(--color-k26-control)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '220px', overflow: 'clip' }}>\n            <div style={{ backgroundColor: 'var(--color-k26-side-surface)', borderRightColor: 'var(--color-k26-rule)', borderRightStyle: 'solid', borderRightWidth: '1px', boxSizing: 'border-box', flexShrink: '0', width: '52px' }} />\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1' }}>\n              <div style={{ borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '16px' }} />\n              <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexGrow: '1' }}>\n                <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '6px', padding: '12px' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-control)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '8px', width: 'round(40%, 1px)' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-selected-row)', borderLeftColor: 'var(--color-k26-action)', borderLeftStyle: 'solid', borderLeftWidth: '2px', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-rule)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-rule)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                </div>\n                <div style={{ borderLeftColor: 'var(--color-k26-rule)', borderLeftStyle: 'solid', borderLeftWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', gap: '6px', padding: '12px', width: '96px' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-text)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '16px', width: 'round(70%, 1px)' }} />\n                  <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '4px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '40px' }} />\n                  <div style={{ boxSizing: 'border-box', flexBasis: '0%', flexGrow: '1' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-action)', borderRadius: '3px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '15px', fontWeight: 600, lineHeight: '20px' }}>\n            A. Lista och panel\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Köer och register. Grupperad lista till vänster, vald rad öppnar detaljpanelen (420 px). Exempel: K-10, K-20, K-40.\n          </div>\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '12px' }}>\n          <div style={{ borderColor: 'var(--color-k26-control)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '220px', overflow: 'clip' }}>\n            <div style={{ backgroundColor: 'var(--color-k26-side-surface)', borderRightColor: 'var(--color-k26-rule)', borderRightStyle: 'solid', borderRightWidth: '1px', boxSizing: 'border-box', flexShrink: '0', width: '52px' }} />\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1' }}>\n              <div style={{ borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '16px' }} />\n              <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexGrow: '1' }}>\n                <div style={{ backgroundColor: 'var(--color-k26-side-surface)', borderRightColor: 'var(--color-k26-rule)', borderRightStyle: 'solid', borderRightWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', gap: '6px', paddingBlock: '8px', paddingInline: '6px', width: '48px' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-surface)', borderColor: 'var(--color-k26-rule)', borderRadius: '3px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '14px' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-rule)', borderRadius: '3px', boxSizing: 'border-box', flexShrink: '0', height: '14px' }} />\n                </div>\n                <div style={{ backgroundColor: '#EEF1F5', boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexGrow: '1', padding: '12px' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-surface)', borderColor: 'var(--color-k26-control)', borderRadius: '3px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexBasis: '0%', flexGrow: '1' }} />\n                </div>\n                <div style={{ borderLeftColor: 'var(--color-k26-rule)', borderLeftStyle: 'solid', borderLeftWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', flexShrink: '0', gap: '6px', padding: '12px', width: '84px' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-text)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '16px', width: 'round(70%, 1px)' }} />\n                  <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '4px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '40px' }} />\n                  <div style={{ boxSizing: 'border-box', flexBasis: '0%', flexGrow: '1' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-action)', borderRadius: '3px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '15px', fontWeight: 600, lineHeight: '20px' }}>\n            B. Original och panel\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Granskning mot underlag. Kö, originalet i mitten, beslut till höger. Originalet visas alltid bredvid det som ska godkännas. Exempel: K‑11, K‑21.\n          </div>\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '12px' }}>\n          <div style={{ borderColor: 'var(--color-k26-control)', borderRadius: '8px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', display: 'flex', flexShrink: '0', height: '220px', overflow: 'clip' }}>\n            <div style={{ backgroundColor: 'var(--color-k26-side-surface)', borderRightColor: 'var(--color-k26-rule)', borderRightStyle: 'solid', borderRightWidth: '1px', boxSizing: 'border-box', flexShrink: '0', width: '52px' }} />\n            <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1' }}>\n              <div style={{ borderBottomColor: 'var(--color-k26-rule)', borderBottomStyle: 'solid', borderBottomWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '16px' }} />\n              <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexGrow: '1', justifyContent: 'center', padding: '16px' }}>\n                <div style={{ boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '6px', width: 'round(62%, 1px)' }}>\n                  <div style={{ backgroundColor: 'var(--color-k26-text)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '16px', width: 'round(50%, 1px)' }} />\n                  <div style={{ backgroundColor: 'var(--color-k26-rule)', borderRadius: '2px', boxSizing: 'border-box', flexShrink: '0', height: '12px' }} />\n                  <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '4px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '56px' }} />\n                  <div style={{ borderColor: 'var(--color-k26-rule)', borderRadius: '4px', borderStyle: 'solid', borderWidth: '1px', boxSizing: 'border-box', flexShrink: '0', height: '56px' }} />\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '15px', fontWeight: 600, lineHeight: '20px' }}>\n            C. Fokus\n          </div>\n          <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-secondary)', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', lineHeight: '20px' }}>\n            Formulär, utkast, översikter och inställningar. En kolumn, max 1000 px, sektioner i kort. Exempel: K‑08 Översikt, K‑41 Fakturautkast.\n          </div>\n        </div>\n      </div>\n      <div style={{ borderTopColor: 'var(--color-k26-rule)', borderTopStyle: 'solid', borderTopWidth: '1px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', gap: '16px', paddingTop: '32px' }}>\n        <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '20px', fontWeight: 600, letterSpacing: '-0.01em', lineHeight: '28px' }}>\n          Tolv regler\n        </div>\n        <div style={{ boxSizing: 'border-box', display: 'flex', gap: '48px' }}>\n          <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '14px' }}>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontFeatureSettings: '\"tnum\"', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                01\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                En primär knapp per vy. Den säger exakt vad som händer: \"Godkänn och bokför 12 500,00\", aldrig \"OK\".\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                02\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Belopp visas stort i panelens rubrik (32 px, tabulära siffror) och alltid med svensk formatering: 12 500,00.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                03\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Panelens ordning: rubrik, underlag, det som ska hända (kort), kontroll, aktivitet, tom yta, åtgärder längst ned.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                04\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Varje rad med arbete har en statusikon i en 22 px bred kolumn, även när statusen är neutral. Register över bokförda poster, som verifikationer, har ingen.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                05\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Med detaljpanel går listan kant i kant. Utan panel ligger den i ett kort inom sidans 32 px‑marginal, på fokussidor i 1000 px‑kolumnen. Grupper får rubrik och antal i pill.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                06\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Färg betyder status: grön klart, gul behöver dig, röd fel eller förfallet, blå handling. Aldrig dekoration.\n              </div>\n            </div>\n          </div>\n          <div style={{ boxSizing: 'border-box', display: 'flex', flexBasis: '0%', flexDirection: 'column', flexGrow: '1', gap: '14px' }}>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                07\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Spärrade knappar säger varför: \"Välj kund för att skicka till godkännande\".\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                08\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Okänt utfall är ett eget tillstånd. Visa vad som skickades och erbjud \"Kontrollera\", aldrig \"Försök igen\".\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                09\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Förberedelse och godkännande är två steg. Skriv det i en rad ovanför knappen, inte i en ruta.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                10\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Bevis före påstående: visa jämförelsen (bankrad mot underlag) i stället för att skriva att det stämmer.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                11\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Kort text. Ingen förklarande brödtext i gränssnittet; hjälp hör hemma i en länk eller tooltip.\n              </div>\n            </div>\n            <div style={{ boxSizing: 'border-box', display: 'flex', gap: '14px' }}>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-action)', flexShrink: '0', fontFamily: 'var(--font-k26-ui)', fontSize: '13px', fontWeight: 600, lineHeight: '20px', width: '22px' }}>\n                12\n              </div>\n              <div style={{ boxSizing: 'border-box', color: 'var(--color-k26-text)', fontFamily: 'var(--font-k26-ui)', fontSize: '14px', lineHeight: '20px' }}>\n                Använd bara tokens (k26). Ny färg, storlek eller radie kräver en ändring på K-01 först.\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )"}]}