] font-[500] leading-ui-sm text-ui-surface\">\n              Räkna om som ny version\n            </div>\n          </div>\n        </div>\n        <div className=\"py-[10px] px-ui-lg bg-ui-surface\">\n          <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#92400E]\">\n            ! Inaktuell. Sparad 2 okt 08:40. Förväntad betalning ändrades 08:55.\n          </div>\n        </div>\n        <div className=\"flex grow basis-[0%] min-h-[0px]\">\n          <div className=\"w-[800px] flex flex-col py-ui-md px-ui-lg shrink-0\">\n            <div className=\"text-[12px] mb-[6px] font-['Inter',system-ui,sans-serif] font-brand-display leading-ui-sm text-[#475569]\">\n              Sparat resultat, oförändrat\n            </div>\n            <div className=\"flex justify-between h-ui-lg items-center shrink-0 border-t border-t-solid border-t-[#E6EAF0]\">\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#475569]\">\n                Lägsta saldo, grundantagande\n              </div>\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] font-features-['tnum'] leading-ui-sm [color:#0F172A]\">\n                182 450,00, 2 okt\n              </div>\n            </div>\n            <div className=\"flex justify-between h-ui-lg items-center shrink-0 border-t border-t-solid border-t-[#EEF1F5]\">\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#475569]\">\n                Lägsta saldo, försiktigt\n              </div>\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] font-features-['tnum'] leading-ui-sm [color:#0F172A]\">\n                169 950,00, 12 okt\n              </div>\n            </div>\n            <div className=\"flex justify-between h-ui-lg items-center shrink-0 border-t border-t-solid border-t-[#EEF1F5] border-b border-b-solid border-b-[#E6EAF0]\">\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#475569]\">\n                Marginal mot gräns 175 000,00\n              </div>\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] font-features-['tnum'] leading-ui-sm [color:#0F172A]\">\n                −5 050,00\n              </div>\n            </div>\n            <div className=\"text-[12px] mt-ui-md mb-[6px] font-['Inter',system-ui,sans-serif] font-brand-display leading-ui-sm text-[#475569]\">\n              Vad som har ändrats sedan dess\n            </div>\n            <div className=\"flex items-center h-[44px] shrink-0 border-t border-t-solid border-t-[#E6EAF0] border-b border-b-solid border-b-[#E6EAF0]\">\n              <div className=\"w-[110px] text-ui-caption shrink-0 font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#475569]\">\n                2 okt 08:55\n              </div>\n              <div className=\"grow basis-[0%] text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm [color:#0F172A]\">\n                F-2026-0042, 15 000,00: förväntad betalning flyttad från 20 okt till 4 nov av Elin Sund\n              </div>\n            </div>\n            <div className=\"text-[12px] leading-[18px] mt-[10px] font-['Inter',system-ui,sans-serif] text-[#475569]\">\n              Ändringen flyttar en inbetalning ut ur fönstret. Saldot 28 okt sjunker till 190 910,00, men det lägsta saldot är oförändrat. Det avgör en ny version, inte den här bilden.\n            </div>\n          </div>\n          <div className=\"grow basis-[0%] p-ui-md border-l border-l-solid border-l-[#E6EAF0]\">\n            <div className=\"text-ui-control mb-[6px] font-['Inter',system-ui,sans-serif] font-brand-display leading-[18px] text-[#475569]\">\n              Versioner\n            </div>\n            <div className=\"flex justify-between h-ui-lg items-center border-t border-t-solid border-t-[#E6EAF0]\">\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm [color:#0F172A]\">\n                Sparad prognos, 2 okt 08:40\n              </div>\n              <div className=\"text-ui-caption font-['Inter',system-ui,sans-serif] leading-ui-sm text-[#92400E]\">\n                Inaktuell\n              </div>\n            </div>\n            <div className=\"text-[12px] leading-[18px] mt-[12px] font-['Inter',system-ui,sans-serif] text-[#475569]\">\n              En ny beräkning sparas separat. Den här prognosen bevaras.\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )"
